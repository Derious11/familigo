rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isParentOf(userId) {
      return isSignedIn() &&
             firestore.get(/databases/(default)/documents/users/$(userId))
                      .data.parentId == request.auth.uid;
    }

    function belongsToChallenge(challengeId) {
      let challenge = firestore.get(/databases/(default)/documents/challenges/$(challengeId)).data;
      let circle = firestore.get(/databases/(default)/documents/familyCircles/$(challenge.familyCircleId)).data;
      return isSignedIn() && (circle.get('members', {}).get(request.auth.uid, null) == true
        || (circle.get('members', {}).get(request.auth.uid, null) == null && request.auth.uid in circle.memberIds));
    }

    function validImage() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|heif)');
    }

    /*
     * PROFILE PICTURES
     * Path format:
     * /profile-pictures/{userId}/avatar.jpg
     */
    match /profile-pictures/{userId}/{fileName} {

      // Public read is acceptable for avatars
      allow read: if true;

      // Authenticated users may write to their own folder,
      // and parents can update their children's avatars.
      allow write: if isSignedIn() && (request.resource == null || validImage()) &&
                   (request.auth.uid == userId || isParentOf(userId));
    }

    /*
     * REPLY IMAGES
     * Path format:
     * /reply-images/{userId}/{challengeId}/{fileId}.jpg
     */
    match /reply-images/{userId}/{challengeId}/{fileName} {
      // Reads allowed only to authenticated users
      allow read: if isSignedIn() && belongsToChallenge(challengeId);

      // Writes allowed to owner OR parent
      allow write: if isSignedIn() && belongsToChallenge(challengeId)
                   && (request.resource == null || validImage())
                   && (request.auth.uid == userId || isParentOf(userId));
    }

    /*
     * FEEDBACK IMAGES
     * Path format:
     * /feedback-images/{userId}/{fileId}.jpg
     */
    match /feedback-images/{userId}/{fileName} {
      // User can write their own, Admins or User can read
      allow write: if request.auth != null && request.auth.uid == userId
        && (request.resource == null || validImage());
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
    }

    /*
     * DEFAULT DENY
     */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
