{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/firebase-runtime-config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/firebase-messaging-sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/site.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/landing-v2",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/landingpagea",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/landingpageb",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/parents",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/teens",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/early-access-v2",
        "destination": "/early-access",
        "type": 301
      },
      {
        "source": "/login-v2",
        "destination": "/login",
        "type": 301
      },
      {
        "source": "/app-preview",
        "destination": "/app",
        "type": 301
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "location": "nam5",
    "indexes": "firestore.development.indexes.json"
  },
  "auth": {
    "authorizedDomains": [
      "localhost",
      "familigo-dev-11643.firebaseapp.com",
      "familigo-dev-11643.web.app"
    ],
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "FamiliGo Development",
        "supportEmail": "ron.clement80@gmail.com"
      }
    }
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        ".env*"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "runtime": "nodejs22"
    }
  ]
}
