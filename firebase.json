{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        ".env*"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/landing-v2",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/landingpagea",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/landingpageb",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/parents",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/teens",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/early-access-v2",
        "destination": "/early-access",
        "type": 301
      },
      {
        "source": "/login-v2",
        "destination": "/login",
        "type": 301
      },
      {
        "source": "/app-preview",
        "destination": "/app",
        "type": 301
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
