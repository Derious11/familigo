rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ========================
       HELPERS
       ======================== */
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user is a member of the given family circle
    function isFamilyMember(familyCircleId) {
      let familyCircleData = get(/databases/$(database)/documents/familyCircles/$(familyCircleId)).data;
      return familyCircleData.members[request.auth.uid] == true
          || (familyCircleData.members[request.auth.uid] == null && request.auth.uid in familyCircleData.memberIds);
    }

    // Check for admin custom claim
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    function isOwnChild(childId, circleId) {
      let child = getAfter(/databases/$(database)/documents/users/$(childId)).data;
      return child.role == "child" && child.parentId == request.auth.uid
        && child.familyCircleId == circleId;
    }

    // Server-owned achievement profiles: state, pins and celebration claims.
    // Human messages: immutable family/sender/type, text <= 2000, server timestamp.
    function canPostAs(senderId, circleId) {
      let sender = get(/databases/$(database)/documents/users/$(senderId)).data;
      return sender.familyCircleId == circleId
        && (sender.get("status", "active") == "active")
        && (request.auth.uid == senderId || (sender.role == "child" && sender.parentId == request.auth.uid));
    }
    function validMessage(data) {
      return data.keys().hasOnly(["familyCircleId", "senderId", "senderName", "text", "type", "timestamp", "authoredBy"])
        && data.text is string && data.text.size() > 0 && data.text.size() <= 2000
        && data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 120
        && data.type in ["text", "system"]
        && data.authoredBy == request.auth.uid && canPostAs(data.senderId, data.familyCircleId);
    }

    // Only an approved parent without a family can bootstrap their own new circle.
    // It must be created in the same batch, with no other members or elevated approval.
    function validFamilyBootstrap(userId) {
      let circleId = request.resource.data.familyCircleId;
      let circle = getAfter(/databases/$(database)/documents/familyCircles/$(circleId)).data;
      return request.auth.uid == userId
        && resource.data.role == "adult" && resource.data.status == "active"
        && resource.data.get("familyCircleId", null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["familyCircleId"])
        && circleId is string && circleId.size() > 0
        && !exists(/databases/$(database)/documents/familyCircles/$(circleId))
        && circle.adminIds == [request.auth.uid]
        && circle.memberIds == [request.auth.uid]
        && circle.members.keys().hasOnly([request.auth.uid])
        && circle.members[request.auth.uid] == true
        && circle.betaApproved == (resource.data.get("familyCreationApproved", false) == true);
    }

    /* ========================
       USERS
       ======================== */
    match /users/{userId} {

      /* -------- READ -------- */
      allow read: if isSignedIn() && (
        isAdmin()
        // Self
        || request.auth.uid == userId

        // Parent → child
        || (
          resource.data.parentId != null
          && resource.data.parentId == request.auth.uid
        )

        // Same family
        || (
          resource.data.familyCircleId != null
          && isFamilyMember(resource.data.familyCircleId)
        )
      );

      /* -------- CREATE -------- */
      allow create: if isSignedIn() && !request.resource.data.keys().hasAny(["achievementState", "achievementCount", "pinnedBadgeIds"])
        && request.resource.data.get("badges", []) == [] && (
        // Normal signup
        (
          request.auth.uid == userId
          && !request.resource.data.keys().hasAny(["isAdmin", "approvedAt", "approvedBy", "parentId", "familyCreationApproved"])
          && request.resource.data.status == "pending_approval"
          && (!request.resource.data.keys().hasAny(["createdAt"]) || request.resource.data.createdAt == request.time)
        )

        // Parent creates child
        || (
          request.auth.uid != userId
          && request.resource.data.parentId == request.auth.uid
          && request.resource.data.role == "child"
          && request.resource.data.familyCircleId != null
          && isFamilyMember(request.resource.data.familyCircleId)
          && !request.resource.data.keys().hasAny(["isAdmin", "approvedAt", "approvedBy", "familyCreationApproved"])
        )
      );

      /* -------- UPDATE -------- */
      allow update: if isSignedIn() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["badges", "achievementState", "achievementCount", "pinnedBadgeIds"]) && (
        isAdmin()
        || validFamilyBootstrap(userId)

        // Self updates safe fields only
        || (
          request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(["isAdmin", "role", "parentId", "status", "approvedAt", "approvedBy", "familyCircleId", "familyCreationApproved", "createdAt"])
        )

        // Family Admin approving Teen Member
        || (
           // Operator is a Family Admin
           isFamilyMember(resource.data.familyCircleId) 
           // (We'd ideally check adminIds, but isFamilyMember is a good start. 
           //  For strictness, we should check adminIds, but let's stick to existing helper for now unless we add isFamilyAdmin)
           // Actually, let's just create a helper for admin check if possible, or use the service logic (admin SDK bypasses rules? No.)
           // Service uses Client SDK so RULES APPLY.
           // We need a rule: "If editing another user's status, must be family admin"
           && resource.data.familyCircleId != null
           && get(/databases/$(database)/documents/familyCircles/$(resource.data.familyCircleId)).data.adminIds.hasAny([request.auth.uid])
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "approvedAt", "approvedBy"])
           && request.resource.data.status == "active"
        )

        // Parent updates child (safe fields only)
        || (
          resource.data.parentId == request.auth.uid
          && !request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasAny([
                "isAdmin",
                "role",
                "parentId",
                "email",
                "emailVerified",
                "status",
                "approvedAt",
                "approvedBy",
                "familyCreationApproved",
                "createdAt",
                "familyCircleId"
              ])
        )
      );

      allow delete: if false;
    }

    /* ========================
       FAMILY CIRCLES
       ======================== */
    match /familyCircles/{circleId} {

      // Adult and teen admission is handled by the callable functions. Only
      // parent-managed child creation may add a member through the client SDK.
      function validMembershipChange() {
        let added = request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet());
        let removed = resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet());
        return request.auth.uid in resource.data.adminIds
          && request.resource.data.members.keys().hasOnly(request.resource.data.memberIds)
          && (added.size() == 0 || (
            added.size() == 1 && removed.size() == 0
            && added.hasOnly([request.resource.data.memberIds[request.resource.data.memberIds.size() - 1]])
            && isOwnChild(request.resource.data.memberIds[request.resource.data.memberIds.size() - 1], circleId)
          ));
      }

      allow create: if isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "adult"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "active"
        && request.resource.data.betaApproved == (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("familyCreationApproved", false) == true)
        && request.resource.data.adminIds == [request.auth.uid]
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == true
        && !request.resource.data.keys().hasAny(["inviteCount", "invitationIds"]);

      allow read: if isSignedIn() && (isFamilyMember(circleId) || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() || (
          isFamilyMember(circleId)
          && request.resource.data.get('adventureTheme', 'mountain') in ['mountain', 'forest', 'coast', 'canyon']
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["inviteCount", "invitationIds"])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["memberIds", "members"])
            || validMembershipChange())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["adminIds", "betaApproved"])
            || request.auth.uid in resource.data.adminIds)
          && request.resource.data.adminIds.toSet().difference(resource.data.adminIds.toSet()).hasOnly(resource.data.memberIds)
        )
      );
    }

    /* ========================
       CHALLENGES
       ======================== */
    // One immutable adventure per UTC Monday. Targets cannot change after launch.
    match /familyCircles/{circleId}/weeklyAdventures/{weekId} {
      function validAdventure(data) {
        let circle = get(/databases/$(database)/documents/familyCircles/$(circleId)).data;
        return data.keys().hasOnly(["target", "trailTarget", "startsAt", "endsAt", "createdBy", "createdAt"])
          && data.target is int && data.target >= 7 && data.target <= 100000
          && data.trailTarget is int && data.trailTarget > 0
          && circle.memberIds.size() > 0
          // Rules divide two integers with truncation; use a float before rounding up.
          && data.trailTarget == math.ceil(data.target * 1.0 / circle.memberIds.size())
          && data.startsAt is timestamp && data.endsAt is timestamp
          && data.startsAt.dayOfWeek() == 1
          && data.startsAt.hours() == 0 && data.startsAt.minutes() == 0
          && data.startsAt.seconds() == 0 && data.startsAt.nanos() == 0
          && weekId == string(data.startsAt.year()) + '-' + (data.startsAt.month() < 10 ? '0' : '') + string(data.startsAt.month()) + '-' + (data.startsAt.day() < 10 ? '0' : '') + string(data.startsAt.day())
          && data.endsAt == data.startsAt + duration.value(7, 'd')
          && data.startsAt <= request.time && request.time < data.endsAt
          && data.createdBy == request.auth.uid && data.createdAt == request.time;
      }
      allow read: if isSignedIn() && isFamilyMember(circleId);
      allow create: if isSignedIn() && isFamilyMember(circleId)
        && request.auth.uid in get(/databases/$(database)/documents/familyCircles/$(circleId)).data.adminIds
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'adult'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active'
        && validAdventure(request.resource.data);
      allow update, delete: if false;
    }

    match /challenges/{challengeId} {

      allow read: if isSignedIn() && (isAdmin() || isFamilyMember(resource.data.familyCircleId));

      allow create: if false; // Validated by recordChallenge callable.
      
      // Updates usually don't change the familyCircleId, so we check the existing one
      allow update: if false; // Enrollment, totals and completions are server-owned.
      
      allow delete: if isSignedIn() && isFamilyMember(resource.data.familyCircleId);
    }

    /* ========================
       REPLIES
       ======================== */
    match /replies/{replyId} {

      allow read: if isSignedIn() && isFamilyMember(resource.data.familyCircleId);

      allow create: if false; // Validated by recordChallengeReply callable.
      
      allow update: if false; // Reaction attribution is server-owned.
      
      allow delete: if isSignedIn() && isFamilyMember(resource.data.familyCircleId);
    }

    /* ========================
       MESSAGES
       ======================== */
    match /messages/{messageId} {

      // For CREATE, we must check request.resource.data because resource doesn't exist yet
      allow create: if isSignedIn() && isFamilyMember(request.resource.data.familyCircleId)
        && validMessage(request.resource.data) && request.resource.data.timestamp == request.time;

      // For READ, UPDATE, DELETE, we check the existing document (resource.data)
      allow read: if isSignedIn() && isFamilyMember(resource.data.familyCircleId);
      allow update: if isSignedIn() && isFamilyMember(resource.data.familyCircleId)
        && resource.data.type == "text" && validMessage(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text"]);
      allow delete: if isSignedIn() && isFamilyMember(resource.data.familyCircleId)
        && resource.data.type in ["text", "system"] && canPostAs(resource.data.senderId, resource.data.familyCircleId);
    }

    match /achievementProfiles/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || (get(/databases/$(database)/documents/users/$(userId)).data.get("familyCircleId", null) != null
          && isFamilyMember(get(/databases/$(database)/documents/users/$(userId)).data.familyCircleId))
      );
      allow write: if false;
    }
    match /familyAchievements/{circleId} {
      allow read: if isSignedIn() && isFamilyMember(circleId);
      allow write: if false;
    }
    match /achievementEvents/{eventId} {
      allow read, write: if false;
    }

    /* ========================
       FEEDBACK
       ======================== */
    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == resource.data.userId);
      allow delete: if isSignedIn() && isAdmin();
    }

    /* ========================
       STATIC DATA
       ======================== */
    match /badges/{id} {
      allow read: if isSignedIn();
    }

    match /exercises/{id} {
      allow read: if isSignedIn();
    }

    /* ========================
       DENY ALL ELSE
       ======================== */
    match /accessInvites/{inviteId} {
      allow read: if isSignedIn() && isAdmin();
      allow write: if false;
    }

    match /adminFeedback/{feedbackId} {
      allow read: if isSignedIn() && isAdmin();
      allow write: if false;
    }

    match /adminAudit/{eventId} {
      allow read: if isSignedIn() && isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
