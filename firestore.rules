rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ========================
       HELPERS
       ======================== */
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user is a member of the given family circle
    function isFamilyMember(familyCircleId) {
      let familyCircleData = get(/databases/$(database)/documents/familyCircles/$(familyCircleId)).data;
      return familyCircleData.members[request.auth.uid] == true
          || (familyCircleData.members[request.auth.uid] == null && request.auth.uid in familyCircleData.memberIds);
    }

    // Check for admin custom claim
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    function isOwnChild(childId, circleId) {
      let child = getAfter(/databases/$(database)/documents/users/$(childId)).data;
      return child.role == "child" && child.parentId == request.auth.uid
        && child.familyCircleId == circleId;
    }

    // Only an approved parent without a family can bootstrap their own new circle.
    // It must be created in the same batch, with no other members or elevated approval.
    function validFamilyBootstrap(userId) {
      let circleId = request.resource.data.familyCircleId;
      let circle = getAfter(/databases/$(database)/documents/familyCircles/$(circleId)).data;
      return request.auth.uid == userId
        && resource.data.role == "adult" && resource.data.status == "active"
        && resource.data.get("familyCircleId", null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["familyCircleId"])
        && circleId is string && circleId.size() > 0
        && !exists(/databases/$(database)/documents/familyCircles/$(circleId))
        && circle.adminIds == [request.auth.uid]
        && circle.memberIds == [request.auth.uid]
        && circle.members.keys().hasOnly([request.auth.uid])
        && circle.members[request.auth.uid] == true && circle.betaApproved == false;
    }

    /* ========================
       USERS
       ======================== */
    match /users/{userId} {

      /* -------- READ -------- */
      allow read: if isSignedIn() && (
        isAdmin()
        // Self
        || request.auth.uid == userId

        // Parent → child
        || (
          resource.data.parentId != null
          && resource.data.parentId == request.auth.uid
        )

        // Same family
        || (
          resource.data.familyCircleId != null
          && isFamilyMember(resource.data.familyCircleId)
        )
      );

      /* -------- CREATE -------- */
      allow create: if isSignedIn() && (
        // Normal signup
        (
          request.auth.uid == userId
          && !request.resource.data.keys().hasAny(["isAdmin", "approvedAt", "approvedBy", "parentId"])
          && request.resource.data.status == "pending_approval"
        )

        // Parent creates child
        || (
          request.auth.uid != userId
          && request.resource.data.parentId == request.auth.uid
          && request.resource.data.role == "child"
          && request.resource.data.familyCircleId != null
          && isFamilyMember(request.resource.data.familyCircleId)
          && !request.resource.data.keys().hasAny(["isAdmin", "approvedAt", "approvedBy"])
        )
      );

      /* -------- UPDATE -------- */
      allow update: if isSignedIn() && (
        isAdmin()
        || validFamilyBootstrap(userId)

        // Self updates safe fields only
        || (
          request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(["isAdmin", "role", "parentId", "status", "approvedAt", "approvedBy", "familyCircleId"])
        )

        // Family Admin approving Teen Member
        || (
           // Operator is a Family Admin
           isFamilyMember(resource.data.familyCircleId) 
           // (We'd ideally check adminIds, but isFamilyMember is a good start. 
           //  For strictness, we should check adminIds, but let's stick to existing helper for now unless we add isFamilyAdmin)
           // Actually, let's just create a helper for admin check if possible, or use the service logic (admin SDK bypasses rules? No.)
           // Service uses Client SDK so RULES APPLY.
           // We need a rule: "If editing another user's status, must be family admin"
           && resource.data.familyCircleId != null
           && get(/databases/$(database)/documents/familyCircles/$(resource.data.familyCircleId)).data.adminIds.hasAny([request.auth.uid])
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "approvedAt", "approvedBy"])
           && request.resource.data.status == "active"
        )

        // Parent updates child (safe fields only)
        || (
          resource.data.parentId == request.auth.uid
          && !request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasAny([
                "isAdmin",
                "role",
                "parentId",
                "email",
                "emailVerified",
                "status",
                "approvedAt",
                "approvedBy",
                "familyCircleId"
              ])
        )
      );

      allow delete: if false;
    }

    /* ========================
       FAMILY CIRCLES
       ======================== */
    match /familyCircles/{circleId} {

      // Adult and teen admission is handled by the callable functions. Only
      // parent-managed child creation may add a member through the client SDK.
      function validMembershipChange() {
        let added = request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet());
        let removed = resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet());
        return request.auth.uid in resource.data.adminIds
          && request.resource.data.members.keys().hasOnly(request.resource.data.memberIds)
          && (added.size() == 0 || (
            added.size() == 1 && removed.size() == 0
            && added.hasOnly([request.resource.data.memberIds[request.resource.data.memberIds.size() - 1]])
            && isOwnChild(request.resource.data.memberIds[request.resource.data.memberIds.size() - 1], circleId)
          ));
      }

      allow create: if isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "adult"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "active"
        && request.resource.data.betaApproved == false
        && request.resource.data.adminIds == [request.auth.uid]
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == true
        && !request.resource.data.keys().hasAny(["inviteCount", "invitationIds"]);

      allow read: if isSignedIn() && (isFamilyMember(circleId) || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() || (
          isFamilyMember(circleId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["inviteCount", "invitationIds"])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["memberIds", "members"])
            || validMembershipChange())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["adminIds", "betaApproved"])
            || request.auth.uid in resource.data.adminIds)
          && request.resource.data.adminIds.toSet().difference(resource.data.adminIds.toSet()).hasOnly(resource.data.memberIds)
        )
      );
    }

    /* ========================
       CHALLENGES
       ======================== */
    match /challenges/{challengeId} {

      allow read: if isSignedIn() && (isAdmin() || isFamilyMember(resource.data.familyCircleId));

      allow create: if isSignedIn() && isFamilyMember(request.resource.data.familyCircleId);
      
      // Updates usually don't change the familyCircleId, so we check the existing one
      allow update: if isSignedIn() && isFamilyMember(resource.data.familyCircleId);
      
      allow delete: if isSignedIn() && isFamilyMember(resource.data.familyCircleId);
    }

    /* ========================
       REPLIES
       ======================== */
    match /replies/{replyId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn() && isFamilyMember(request.resource.data.familyCircleId);
      
      allow update: if isSignedIn() && isFamilyMember(resource.data.familyCircleId);
      
      allow delete: if isSignedIn() && isFamilyMember(resource.data.familyCircleId);
    }

    /* ========================
       MESSAGES
       ======================== */
    match /messages/{messageId} {

      // For CREATE, we must check request.resource.data because resource doesn't exist yet
      allow create: if isSignedIn() && isFamilyMember(request.resource.data.familyCircleId);

      // For READ, UPDATE, DELETE, we check the existing document (resource.data)
      allow read, update, delete: if isSignedIn() && isFamilyMember(resource.data.familyCircleId);
    }

    /* ========================
       FEEDBACK
       ======================== */
    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == resource.data.userId);
      allow delete: if isSignedIn() && isAdmin();
    }

    /* ========================
       STATIC DATA
       ======================== */
    match /badges/{id} {
      allow read: if isSignedIn();
    }

    match /exercises/{id} {
      allow read: if isSignedIn();
    }

    /* ========================
       DENY ALL ELSE
       ======================== */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
